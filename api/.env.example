# Copy to your serverless host's environment variables — NEVER commit real values.
# Required for the /api/lead endpoint to deliver enquiry emails:

EMAIL_API_KEY=   # e.g. Resend API key (re_...) — set in host UI, not in code
CONTACT_EMAIL=   # destination inbox for enquiries, e.g. hello@clixed.com
FROM_EMAIL=      # verified sender address at the email provider
ALLOWED_ORIGIN=  # production site origin, e.g. https://www.clixed.com