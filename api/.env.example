# CLIxED API environment variables
# Copy this file to .env and fill in values for local development.

# Substack publication URL (used by api/substack.js)
# Default: https://test7334.substack.com (test publication)
SUBSTACK_PUBLICATION_URL=https://test7334.substack.com

# Server port (used by server.cjs)
# Default: 5500
PORT=5500

# Lead capture — Resend API (used by api/lead.js)
# EMAIL_API_KEY=re_your_key_here
# CONTACT_EMAIL=your@email.com
# FROM_EMAIL=noreply@yourdomain.com
# ALLOWED_ORIGIN=https://yourdomain.com
